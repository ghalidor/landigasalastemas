{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "casinoweb": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/casinoweb",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pdf.worker.min.js",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/flag-icons/css/flag-icons.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/aos/dist/aos.css",
              "src/styles/base.css",
              "src/styles/intro.css",
              "src/styles/admin.css",
              "src/app/themes/classic/classic.css",
              "src/app/themes/damasco/damasco.css",
              "src/app/themes/isla/isla.css",
              "src/app/themes/mambos/mambos.css",
              "src/app/themes/megacasino/megacasino.css",
              "src/app/themes/keops/keops.css",
              "src/app/themes/excalibur/excalibur.css",
              "src/app/themes/winmeier/winmeier.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "media"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "casinoweb:build:production"
            },
            "development": {
              "buildTarget": "casinoweb:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}