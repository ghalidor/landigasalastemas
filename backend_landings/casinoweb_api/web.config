<?xml version="1.0" encoding="utf-8"?>
<!--  Va en la raiz del proyecto de la API, junto a Program.cs. Al publicar,
      Visual Studio le anade solo la parte de aspNetCore y lo demas se queda. -->
<configuration>
  <system.webServer>

    <!--  Maximo que IIS deja subir, en bytes: 90 MB. Un poco por encima del
          mayor limite de appsettings (MaxVideoMb: 80), porque el envio lleva
          algo mas que el archivo. Los limites por tipo los pone el codigo. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="94371840" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
